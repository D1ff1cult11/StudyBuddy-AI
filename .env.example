# ==========================================
# AI Study Buddy - Environment Variables
# ==========================================

# NOTE: Never commit the actual .env file. This is just an example template.
# All production variables should be set in the Vercel/Netlify dashboard.

# API Key for OpenRouter / Gemini (Used by the AI Agent to generate flashcards)
VITE_AI_API_KEY=your_api_key_here

# Telemetry / Analytics (if applicable)
VITE_ENABLE_ANALYTICS=false
